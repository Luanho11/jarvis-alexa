# groq o gemini; si el principal falla se usa el otro (si tiene clave)
PROVEEDOR_LLM=groq
GROQ_API_KEY=
GEMINI_API_KEY=
MODELO_GROQ=openai/gpt-oss-120b
MODELO_GEMINI=gemini-3.5-flash-lite
ALEXA_SKILL_ID=
# Opcional: ciudad para el clima (vacío = la detecta por tu IP)
CIUDAD=
# Opcional: ruta del archivo de agenda (por defecto agenda.json en la carpeta del proyecto)
# AGENDA_ARCHIVO=C:\Users\tu_usuario\agenda.json
# Tu dominio gratis de ngrok, sin https:// (lo ves en dashboard.ngrok.com > Domains)
NGROK_DOMINIO=
# Opcional: país de las noticias en código de 2 letras (MX, AR, CO, ES, PE...)
PAIS_NOTICIAS=MX
# Opcional: no para que no se abra la interfaz visual (hud) en la pantalla al hablar con Jarvis
HUD_ACTIVO=si
# Opcional: modelo de Gemini para los encargos largos en segundo plano (si falla usa MODELO_GEMINI y luego Groq)
MODELO_PROFUNDO=gemini-3.8-flash
# Opcional: carpeta de tus notas en Markdown (puede ser tu bóveda de Obsidian)
# NOTAS_CARPETA=C:\Users\tu_usuario\Documents\Obsidian\Jarvis
# Opcional: que el Echo diga los recordatorios y temporizadores con Voice Monkey (gratis, 200 envíos/mes).
# Token en app.voicemonkey.io/tokens e ID del Speaker en la consola de Voice Monkey (ver README).
VOICEMONKEY_TOKEN=
VOICEMONKEY_DISPOSITIVO=
AVISOS_EN_ECHO=si
# Máximo de avisos al mes en el Echo (deja margen hasta los 200 del plan gratis)
LIMITE_ECHO_MES=150
